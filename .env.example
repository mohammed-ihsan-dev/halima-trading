# Halima Trading L.L.C. — Environment Variables Template
# Copy this file to .env.local for local development.
# For Vercel deployment, add these variables in Vercel Project Settings -> Environment Variables.

# MongoDB Atlas Connection
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/halima?retryWrites=true&w=majority"
MONGODB_DB="halima"

# Admin Authentication Secret
ADMIN_SESSION_SECRET="your-secure-admin-session-secret-2026"

# Stripe Payments (Optional for Demo)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Application Base URL
NEXT_PUBLIC_APP_URL="https://halima-trading.vercel.app"

# Product image storage — Supabase Storage (preferred for new uploads).
# Set real values in .env.local and in Vercel; never commit them.
NEXT_PUBLIC_SUPABASE_URL=https://xaujatpichfxrzwyyksj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional; defaults to product-images
SUPABASE_STORAGE_BUCKET=product-images

# Product image pipeline (scripts/product-images/pipeline.mjs) — server-side / CLI only.
# None of these may be prefixed with NEXT_PUBLIC_. Leave empty to disable the feature.
# Open Icecat (discovery source; images usable only once the licence conditions are met)
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=
# Image search provider: "serpapi" or "none". Results are leads only — never treated as licensed.
IMAGE_SEARCH_PROVIDER=none
SERPAPI_API_KEY=
IMAGE_CANDIDATES_PER_PRODUCT=5
IMAGE_SEARCH_COUNTRY=ae
IMAGE_SEARCH_TIMEOUT_MS=20000
# Hard cap on SerpApi requests the pipeline may ever make (local ledger, failed requests included; never reset
# automatically). Keep it below the plan's monthly allowance (free plan: 250).
SERPAPI_REQUEST_LIMIT=200
IMAGE_SEARCH_MIN_INTERVAL_MS=1200
# Optional AI ranking of candidates (advisory only; never approves). Requires: npm install @anthropic-ai/sdk
IMAGE_VISION_PROVIDER=none
ANTHROPIC_API_KEY=
IMAGE_VISION_MODEL=claude-opus-5-5
IMAGE_VISION_TIMEOUT_MS=60000
# Downloads and output
IMAGE_DOWNLOAD_TIMEOUT_MS=20000
IMAGE_MAX_DOWNLOAD_BYTES=15728640
IMAGE_OUTPUT_SIZE=800
